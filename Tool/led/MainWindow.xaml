<Window x:Class="LedStarSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:LedStarSimulator.ViewModels"
        Title="LED Star Simulator"
        Width="1050" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Window.Resources>
        <!-- Заголовок секции -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Стиль текстового поля ввода значения -->
        <Style x:Key="ValueTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="55"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Background" Value="#2a2a3e"/>
            <Setter Property="BorderBrush" Value="#4a4a6e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Базовый стиль слайдера -->
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
        </Style>

        <!-- Красный слайдер -->
        <Style x:Key="RedSlider" BasedOn="{StaticResource SliderStyle}" TargetType="Slider">
            <Setter Property="Foreground" Value="#ff4444"/>
            <Setter Property="BorderBrush" Value="#ff4444"/>
        </Style>

        <!-- Зелёный слайдер -->
        <Style x:Key="GreenSlider" BasedOn="{StaticResource SliderStyle}" TargetType="Slider">
            <Setter Property="Foreground" Value="#44ff44"/>
            <Setter Property="BorderBrush" Value="#44ff44"/>
        </Style>

        <!-- Синий слайдер -->
        <Style x:Key="BlueSlider" BasedOn="{StaticResource SliderStyle}" TargetType="Slider">
            <Setter Property="Foreground" Value="#4488ff"/>
            <Setter Property="BorderBrush" Value="#4488ff"/>
        </Style>

        <!-- Стиль блока канала -->
        <Style x:Key="ChannelBlock" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#d0d0d0"/>
            <Setter Property="BorderBrush" Value="#3a3a5e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <!-- Стиль кнопки быстрого цвета -->
        <Style x:Key="QuickColorButton" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4a4a6e"/>
            <Setter Property="BorderBrush" Value="#6a6a8e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Заголовки столбцов DataGrid в стиле Windows -->
        <Style x:Key="WindowsDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#f3f3f3"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#d0d0d0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Левая панель: данные (25%) -->
            <ColumnDefinition Width="1*" MinWidth="150"/>
            <!-- Разделитель левой панели -->
            <ColumnDefinition Width="Auto"/>
            <!-- Центральная панель: звезда (50%) -->
            <ColumnDefinition Width="2*"/>
            <!-- Разделитель правой панели -->
            <ColumnDefinition Width="Auto"/>
            <!-- Правая панель: управление (25%) -->
            <ColumnDefinition Width="1*" MinWidth="150"/>
        </Grid.ColumnDefinitions>

        <!-- Разделитель левой панели -->
        <GridSplitter Grid.Row="0" Grid.Column="1"
                      Width="5"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Center"
                      ResizeDirection="Columns"
                      Background="#2a2a4e"/>

        <!-- Разделитель правой панели -->
        <GridSplitter Grid.Row="0" Grid.Column="3"
                      Width="5"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Center"
                      ResizeDirection="Columns"
                      Background="#2a2a4e"/>

        <!-- ===== ЛЕВАЯ ЧАСТЬ: Данные ===== -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="#16213e"
                BorderBrush="#2a2a4e"
                BorderThickness="0,0,1,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Данные"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#e94560"
                           Margin="0,0,0,12"/>

                <!-- Кнопка открытия файла -->
                <Button Grid.Row="1"
                        Content="📂 Открыть файл"
                        Height="36"
                        Margin="0,0,0,12"
                        Padding="8,4"
                        FontSize="13"
                        Background="#4a4a6e"
                        Foreground="White"
                        BorderBrush="#6a6a8e"
                        BorderThickness="1"
                        Cursor="Hand"
                        Command="{Binding OpenFileCommand}"/>

                <!-- Информация о файле -->
                <TextBlock Grid.Row="2"
                           Text="{Binding CurrentFileName}"
                           FontSize="11"
                           Foreground="#8888aa"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- Список данных -->
                <TextBlock Grid.Row="3"
                           Text="Элементы последовательности"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#d0d0d0"
                           Margin="0,0,0,6"/>

                <!-- Кнопки анимации -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Button Content="▶ Выполнить"
                            Height="30"
                            Margin="0,0,6,0"
                            Padding="10,0"
                            FontSize="12"
                            Background="#2ecc71"
                            Foreground="White"
                            BorderBrush="#27ae60"
                            BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding ExecuteCommand}"/>
                    <Button Content="⏭ Выполнить всё"
                            Height="30"
                            Padding="10,0"
                            FontSize="12"
                            Background="#3498db"
                            Foreground="White"
                            BorderBrush="#2980b9"
                            BorderThickness="1"
                            Cursor="Hand"
                            Command="{Binding ExecuteAllCommand}"/>
                </StackPanel>

                <DataGrid Grid.Row="5"
                          ItemsSource="{Binding SequenceItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="28"
                          FontSize="12"
                          Background="White"
                          Foreground="#1a1a1a"
                          BorderBrush="#e0e0e0"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ColumnHeaderStyle="{StaticResource WindowsDataGridColumnHeader}"
                          RowBackground="White"
                          AlternatingRowBackground="#f5f5f5"
                          SelectedItem="{Binding SelectedSequenceItem, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип"
                                            Binding="{Binding Type}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Время"
                                            Binding="{Binding Time}"
                                            Width="50"/>
                        <DataGridTextColumn Header="Данные"
                                            Binding="{Binding DataDescription}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ===== ЦЕНТР: Звезда ===== -->
        <Border Grid.Row="0" Grid.Column="2"
                BorderBrush="#2a2a4e"
                BorderThickness="0,0,1,0"
                Padding="10">
            <Canvas x:Name="StarCanvas"
                    Width="500" Height="500"
                    Background="#0f0f1e"
                    ClipToBounds="True">
                <!-- LED-звезда будет отрисована через код -->
            </Canvas>
        </Border>

        <!-- ===== ПРАВАЯ ЧАСТЬ: Управление ===== -->
        <Border Grid.Row="0" Grid.Column="4"
                Background="#16213e"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Заголовок -->
                    <TextBlock Text="LED Star Simulator"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#e94560"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,4"/>
                    <TextBlock Text="21 светодиод · 5-конечная звезда"
                               FontSize="12"
                               Foreground="#8888aa"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- Превью цвета -->
                    <Border x:Name="ColorPreview"
                            Height="60"
                            CornerRadius="8"
                            Margin="0,0,0,12"
                            BorderBrush="#4a4a6e"
                            BorderThickness="1">
                        <Border.Background>
                            <Binding Path="ColorPreviewBrush" Mode="OneWay"/>
                        </Border.Background>
                    </Border>

                    <!-- Выбор LED -->
                    <GroupBox Header="Выбор LED" Style="{StaticResource ChannelBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="LedIndexComboBox"
                                              Grid.Column="0"
                                              Margin="0,0,5,0"
                                              ItemsSource="{Binding LedIndices}"
                                              SelectedIndex="{Binding SelectedLedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemStringFormat="LED {0}"/>
                                <CheckBox x:Name="AllLedsCheckBox"
                                          Grid.Column="1"
                                          Content="Все"
                                          IsChecked="{Binding AllLedsMode, Mode=TwoWay}"
                                          ToolTip="Применить цвет ко всем LED"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== КРАСНЫЙ ===== -->
                    <GroupBox Header="Красный (R)" Style="{StaticResource ChannelBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RedSlider"
                                        Style="{StaticResource RedSlider}"
                                        Grid.Column="0"
                                        Value="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="RedValue"
                                         Style="{StaticResource ValueTextBox}"
                                         Grid.Column="1"
                                         Text="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== ЗЕЛЁНЫЙ ===== -->
                    <GroupBox Header="Зелёный (G)" Style="{StaticResource ChannelBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="GreenSlider"
                                        Style="{StaticResource GreenSlider}"
                                        Grid.Column="0"
                                        Value="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="GreenValue"
                                         Style="{StaticResource ValueTextBox}"
                                         Grid.Column="1"
                                         Text="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== СИНИЙ ===== -->
                    <GroupBox Header="Синий (B)" Style="{StaticResource ChannelBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BlueSlider"
                                        Style="{StaticResource BlueSlider}"
                                        Grid.Column="0"
                                        Value="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="BlueValue"
                                         Style="{StaticResource ValueTextBox}"
                                         Grid.Column="1"
                                         Text="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Кнопки быстрых цветов -->
                    <TextBlock Text="Быстрые цвета"
                               Style="{StaticResource SectionHeader}"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="■ Красный" Style="{StaticResource QuickColorButton}"
                                Background="#ff0000" Foreground="White"
                                Command="{Binding SetRedCommand}"/>
                        <Button Content="■ Зелёный" Style="{StaticResource QuickColorButton}"
                                Background="#00ff00" Foreground="Black"
                                Command="{Binding SetGreenCommand}"/>
                        <Button Content="■ Синий" Style="{StaticResource QuickColorButton}"
                                Background="#0044ff" Foreground="White"
                                Command="{Binding SetBlueCommand}"/>
                        <Button Content="■ Белый" Style="{StaticResource QuickColorButton}"
                                Background="#ffffff" Foreground="Black"
                                Command="{Binding SetWhiteCommand}"/>
                        <Button Content="■ Чёрный" Style="{StaticResource QuickColorButton}"
                                Background="#000000" Foreground="White"
                                Command="{Binding SetBlackCommand}"/>
                        <Button Content="■ Жёлтый" Style="{StaticResource QuickColorButton}"
                                Background="#ffff00" Foreground="Black"
                                Command="{Binding SetYellowCommand}"/>
                        <Button Content="■ Циан" Style="{StaticResource QuickColorButton}"
                                Background="#00ffff" Foreground="Black"
                                Command="{Binding SetCyanCommand}"/>
                        <Button Content="■ Розовый" Style="{StaticResource QuickColorButton}"
                                Background="#ff00ff" Foreground="White"
                                Command="{Binding SetPinkCommand}"/>
                    </WrapPanel>

                    <!-- HEX-код цвета -->
                    <TextBlock Text="Цвет в HEX" Style="{StaticResource SectionHeader}"/>
                    <TextBox Width="120"
                             HorizontalAlignment="Center"
                             FontFamily="Consolas"
                             FontSize="14"
                             Foreground="#e0e0e0"
                             Background="#2a2a3e"
                             BorderBrush="#4a4a6e"
                             BorderThickness="1"
                             Text="{Binding HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="HexValue_PreviewTextInput"
                             PreviewMouseUp="HexValue_PreviewMouseUp"
                             MaxLength="7"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
