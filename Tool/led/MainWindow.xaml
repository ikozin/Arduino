<Window x:Class="LedStarSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:LedStarSimulator.ViewModels"
        Title="LED Star Simulator"
        Width="1050" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Window.Resources>
        <!-- Стиль заголовка секции -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Стиль текстового поля ввода значения -->
        <Style x:Key="ValueTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="55"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Background" Value="#2a2a3e"/>
            <Setter Property="BorderBrush" Value="#4a4a6e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Стиль слайдера -->
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
        </Style>

        <!-- Красный слайдер -->
        <Style x:Key="RedSlider" BasedOn="{StaticResource SliderStyle}" TargetType="Slider">
            <Setter Property="Foreground" Value="#ff4444"/>
            <Setter Property="BorderBrush" Value="#ff4444"/>
        </Style>

        <!-- Зелёный слайдер -->
        <Style x:Key="GreenSlider" BasedOn="{StaticResource SliderStyle}" TargetType="Slider">
            <Setter Property="Foreground" Value="#44ff44"/>
            <Setter Property="BorderBrush" Value="#44ff44"/>
        </Style>

        <!-- Синий слайдер -->
        <Style x:Key="BlueSlider" BasedOn="{StaticResource SliderStyle}" TargetType="Slider">
            <Setter Property="Foreground" Value="#4488ff"/>
            <Setter Property="BorderBrush" Value="#4488ff"/>
        </Style>

        <!-- Стиль блока канала -->
        <Style x:Key="ChannelBlock" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#d0d0d0"/>
            <Setter Property="BorderBrush" Value="#3a3a5e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <!-- Стиль кнопки быстрого цвета -->
        <Style x:Key="QuickColorButton" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4a4a6e"/>
            <Setter Property="BorderBrush" Value="#6a6a8e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <viewmodels:LedStarViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая часть — звезда -->
            <ColumnDefinition Width="*"/>
            <!-- Правая часть — управление -->
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ ЧАСТЬ: Звезда ===== -->
        <Border Grid.Column="0"
                BorderBrush="#2a2a4e"
                BorderThickness="0,0,1,0"
                Padding="10">
            <Canvas x:Name="StarCanvas"
                    Width="500" Height="500"
                    Background="#0f0f1e"
                    ClipToBounds="True">
                <!-- LED-звезда будет отрисована через код -->
            </Canvas>
        </Border>

        <!-- ===== ПРАВАЯ ЧАСТЬ: Управление ===== -->
        <Border Grid.Column="1"
                Background="#16213e"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Заголовок -->
                    <TextBlock Text="LED Star Simulator"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#e94560"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,4"/>
                    <TextBlock Text="21 светодиод · 5-конечная звезда"
                               FontSize="12"
                               Foreground="#8888aa"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- Превью цвета -->
                    <Border x:Name="ColorPreview"
                            Height="60"
                            CornerRadius="8"
                            Margin="0,0,0,12"
                            BorderBrush="#4a4a6e"
                            BorderThickness="1">
                        <Border.Background>
                            <Binding Path="ColorPreviewBrush" Mode="OneWay"/>
                        </Border.Background>
                    </Border>

                    <!-- ===== КРАСНЫЙ ===== -->
                    <GroupBox Header="Красный (R)" Style="{StaticResource ChannelBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RedSlider"
                                        Style="{StaticResource RedSlider}"
                                        Grid.Column="0"
                                        Value="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="RedValue"
                                         Style="{StaticResource ValueTextBox}"
                                         Grid.Column="1"
                                         Text="{Binding Red, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== ЗЕЛЁНЫЙ ===== -->
                    <GroupBox Header="Зелёный (G)" Style="{StaticResource ChannelBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="GreenSlider"
                                        Style="{StaticResource GreenSlider}"
                                        Grid.Column="0"
                                        Value="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="GreenValue"
                                         Style="{StaticResource ValueTextBox}"
                                         Grid.Column="1"
                                         Text="{Binding Green, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== СИНИЙ ===== -->
                    <GroupBox Header="Синий (B)" Style="{StaticResource ChannelBlock}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BlueSlider"
                                        Style="{StaticResource BlueSlider}"
                                        Grid.Column="0"
                                        Value="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="BlueValue"
                                         Style="{StaticResource ValueTextBox}"
                                         Grid.Column="1"
                                         Text="{Binding Blue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:D}}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Кнопки быстрых цветов -->
                    <TextBlock Text="Быстрые цвета"
                               Style="{StaticResource SectionHeader}"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="■ Красный" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetRedCommand}"/>
                        <Button Content="■ Зелёный" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetGreenCommand}"/>
                        <Button Content="■ Синий" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetBlueCommand}"/>
                        <Button Content="■ Белый" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetWhiteCommand}"/>
                        <Button Content="■ Чёрный" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetBlackCommand}"/>
                        <Button Content="■ Жёлтый" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetYellowCommand}"/>
                        <Button Content="■ Циан" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetCyanCommand}"/>
                        <Button Content="■ Розовый" Style="{StaticResource QuickColorButton}"
                                Command="{Binding SetPinkCommand}"/>
                    </WrapPanel>

                    <!-- Hex-код цвета -->
                    <TextBlock Text="Цвет в HEX" Style="{StaticResource SectionHeader}"/>
                    <TextBox Width="120"
                             HorizontalAlignment="Center"
                             FontFamily="Consolas"
                             FontSize="14"
                             Foreground="#e0e0e0"
                             Background="#2a2a3e"
                             BorderBrush="#4a4a6e"
                             BorderThickness="1"
                             Text="{Binding HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="HexValue_PreviewTextInput"
                             PreviewMouseUp="HexValue_PreviewMouseUp"
                             MaxLength="7"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
